{
  "name": "projects",
  "version": "1.0.0",
  "description": "Vanilla TypeScript application with Express + Vite (HTML + CSS + TS + Node API)",
  "scripts": {
    "build": "vite build",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "react": "19",
    "react-dom": "19",
    "react-router": "7"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "4",
    "autoprefixer": "^10.5.0",
    "coze-coding-dev-sdk": "^0.7.21",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "only-allow": "^1.2.2",
    "pm2": "^6.0.14",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vite": "5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.24.2",
      "is-generator-function": "1.0.10"
    }
  }
}
